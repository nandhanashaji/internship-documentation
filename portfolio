    gap:20px;
}

.cert{
    text-align:center;
    background:var(--card);
    padding:25px;
    border-radius:20px;
}

.stats{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(180px,1fr));
    gap:20px;
}

.stat{
    text-align:center;
    padding:25px;
